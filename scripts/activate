#!/bin/bash

# 彩色输出定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 脚本名称
SCRIPT_NAME="activate-clash"

# 默认配置文件和路径
# 当通过 source 命令执行时，$0 指向当前 shell，所以使用 BASH_SOURCE 来获取脚本路径
if [ -n "$BASH_SOURCE" ]; then
    SCRIPT_PATH="$BASH_SOURCE"
else
    SCRIPT_PATH="$0"
fi
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
BASE_DIR="$(dirname "$SCRIPT_DIR")"
source "$SCRIPT_DIR/lib/config.sh"
source "$SCRIPT_DIR/lib/runtime.sh"
DEFAULT_CONFIG="${BASE_DIR}/configs/config.yaml"
CONFIG_DIR="${BASE_DIR}/configs"
LOG_DIR="${BASE_DIR}/logs"
CLASH_BIN="${BASE_DIR}/clash"

# 获取配置文件名（如果提供）
if [ -n "$1" ]; then
    # 如果提供了配置文件名，检查是相对路径还是绝对路径
    if [[ "$1" == /* ]]; then
        CONFIG_FILE="$1"
    else
        # 相对路径，加上配置目录前缀
        CONFIG_FILE="${CONFIG_DIR}/$1"
        # 如果文件不存在，尝试加上 .yaml 后缀
        if [ ! -f "$CONFIG_FILE" ]; then
            CONFIG_FILE="${CONFIG_FILE}.yaml"
        fi
    fi
else
    CONFIG_FILE="$DEFAULT_CONFIG"
fi

# 检查配置文件是否存在
if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}错误：配置文件 '$CONFIG_FILE' 不存在！${NC}"
    echo -e "${YELLOW}提示：请确保配置文件存在或指定正确的配置文件名。${NC}"
    echo -e "${BLUE}用法：$SCRIPT_NAME [配置文件名]${NC}"
    echo -e "${BLUE}示例：$SCRIPT_NAME config_1.yaml${NC}"
    echo -e "${BLUE}配置文件目录：${CONFIG_DIR}${NC}"
    return 1 2>/dev/null || exit 1
fi

# 检查 Clash 是否已经在运行
if pgrep -x "clash" > /dev/null; then
    echo -e "${YELLOW}警告：Clash 已经在运行中！${NC}"
    echo -e "${BLUE}提示：如果需要重启，请先运行 'pkill clash' 停止当前进程。${NC}"
    return 1 2>/dev/null || exit 1
fi

# 提取配置文件名（不带扩展名）用于日志命名
CONFIG_NAME="$(basename "$CONFIG_FILE" .yaml)"
LOG_FILE="${LOG_DIR}/clash_${CONFIG_NAME}.log"

# 检查并自动修复 Mihomo 地理数据库
MIHOMO_DIR="$HOME/.config/mihomo"
CLASH_DIR="$HOME/.config/clash"
echo -e "${BLUE}正在检查 Country.mmdb 和 GeoSite.dat...${NC}"
if ! ensure_clash_geodata "$MIHOMO_DIR" "$CLASH_DIR"; then
    echo -e "${RED}错误：地理数据库准备失败，已取消启动以避免 Clash 崩溃。${NC}"
    return 1 2>/dev/null || exit 1
fi

# API 必须在设置代理环境变量之前读取并用于启动检查。
CONTROLLER=$(get_clash_config_value "$CONFIG_FILE" "external-controller")
CONTROLLER="${CONTROLLER:-127.0.0.1:9090}"
SECRET=$(get_clash_config_value "$CONFIG_FILE" "secret")

# 启动 Clash 代理服务器
echo -e "${BLUE}正在启动 Clash，请稍候...${NC}"

# 自动创建日志目录
mkdir -p "$LOG_DIR"

nohup "$CLASH_BIN" -f "$CONFIG_FILE" > "$LOG_FILE" 2>&1 &
CLASH_PID=$!

# 等待 API 真正可用，同时检测初始化期间的进程退出。
wait_for_clash_api "$CLASH_PID" "$CONTROLLER" "$SECRET" 60
START_RESULT=$?
if [ "$START_RESULT" -ne 0 ]; then
    echo -e "${RED}错误：Clash 启动失败！${NC}"
    if [ "$START_RESULT" -eq 2 ]; then
        echo -e "${YELLOW}提示：等待 API 就绪超时，Clash 进程可能仍在初始化。${NC}"
    fi
    echo -e "${YELLOW}最近的启动日志：${NC}"
    tail -n 20 "$LOG_FILE" 2>/dev/null
    return 1 2>/dev/null || exit 1
fi

# 从配置文件读取 mixed-port
PORT=$(grep -oP 'mixed-port:\s*\K\d+' "$CONFIG_FILE" 2>/dev/null)

# 如果没有找到 mixed-port，尝试读取 port（旧版配置）
if [ -z "$PORT" ]; then
    PORT=$(grep -oP 'port:\s*\K\d+' "$CONFIG_FILE" 2>/dev/null)
fi

# 如果仍然没有找到端口，使用默认端口 7890
if [ -z "$PORT" ]; then
    PORT=7890
    echo -e "${YELLOW}警告：配置文件中未找到端口配置，使用默认端口 $PORT${NC}"
fi

# 设置代理环境变量
export http_proxy=http://127.0.0.1:$PORT
export https_proxy=http://127.0.0.1:$PORT
export ALL_PROXY=socks5://127.0.0.1:$PORT
export all_proxy=socks5://127.0.0.1:$PORT

# 输出启动信息
echo -e "${GREEN}✓ Clash 代理已成功激活！${NC}"
echo -e "${BLUE}配置文件：${NC}$CONFIG_FILE"
echo -e "${BLUE}监听端口：${NC}$PORT"
echo -e "${BLUE}API 地址：${NC}$CONTROLLER"
echo -e "${BLUE}日志文件：${NC}$LOG_FILE"
echo -e "${BLUE}进程 ID：${NC}$CLASH_PID"
echo -e ""
echo -e "${BLUE}环境变量已设置：${NC}"
echo -e "  http_proxy=${http_proxy}"
echo -e "  https_proxy=${https_proxy}"
echo -e "  ALL_PROXY=${ALL_PROXY}"
echo -e ""
echo -e "${YELLOW}使用说明：${NC}"
echo -e "  ${BLUE}select-node${NC}       - 选择代理节点"
echo -e "  ${BLUE}pkill clash${NC}        - 停止 Clash 服务"
echo -e "  ${BLUE}unset http_proxy https_proxy ALL_PROXY all_proxy${NC}  - 取消代理环境变量"
echo -e "  ${BLUE}tail -f $LOG_FILE${NC}  - 查看详细日志"
echo -e ""
echo -e "${GREEN}代理已准备就绪，可以开始使用了！${NC}"
